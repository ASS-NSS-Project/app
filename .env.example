# Copy this file to .env and fill in your values.
# Never commit .env to git.

# --- PostgreSQL ---
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ragdb

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=raguser
RABBITMQ_DEFAULT_PASS=change_me_strong_password
# Optional: override the erlang cluster cookie (default is fine for local dev)
#RABBITMQ_ERLANG_COOKIE=change_me_erlang_cookie

# --- S3 object storage (CESNET e-INFRA) ---
S3_ENDPOINT_URL=https://s3.cl4.du.cesnet.cz
S3_ACCESS_KEY=<provided-by-team>
S3_SECRET_KEY=<provided-by-team>
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_BUCKET_EVIDENCE=rag-evidence
S3_BUCKET_DOCS=rag-documents

# --- AIaaS e-INFRA (shared for LLM + VLM) ---
# Query /v1/models on the endpoint to see available model names.
AIAAS_BASE_URL=https://llm.ai.e-infra.cz/v1
AIAAS_API_KEY=<provided-by-team>
# LLM — text generation model 
AIAAS_LLM_MODEL=qwen3.5-122b
# VLM — vision extraction model 
AIAAS_VLM_MODEL=qwen3.5-122b

# --- JWT (auth tokens) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_hex_string

# --- First Admin User (created on first startup) ---
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change_me_strong_password

# --- Default sources (seeded on startup, comma-separated URLs) ---
# Each URL is created once (idempotent). Leave empty to seed nothing.
DEFAULT_SOURCE_URLS=https://mendelu.cz

# --- OAuth / SSO (production only — not needed for local dev) ---
# Google OAuth2 and Keycloak OIDC are configured in Kubernetes via Vault/ESO.
# Local dev uses JWT login only (FIRST_ADMIN_* above).

# --- Development toggles ---
# Set to true to expose /docs and /redoc (Swagger / ReDoc).
API_DOCS=true