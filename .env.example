# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ragdb

# ── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=raguser
RABBITMQ_DEFAULT_PASS=change_me_strong_password

# ── S3 object storage (CESNET e-INFRA) ───────────────────
S3_ENDPOINT_URL=https://<provided-by-team>
S3_ACCESS_KEY=<provided-by-team>
S3_SECRET_KEY=<provided-by-team>
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_BUCKET_EVIDENCE=rag-evidence
S3_BUCKET_DOCS=rag-documents

# ── LLM — text generation (CERIT-SC AIaaS) ───────────────
# Query /v1/models on the AIaaS endpoint to get the exact model name.
LLM_BASE_URL=https://<aiaas-endpoint>/v1
LLM_API_KEY=<provided-by-team>
LLM_MODEL=<from /v1/models, e.g. llama-3.3-70b-instruct>

# ── VLM — vision extraction (CERIT-SC AIaaS) ─────────────
VLM_BASE_URL=https://<aiaas-endpoint>/v1
VLM_API_KEY=<provided-by-team>
VLM_MODEL=<from /v1/models, e.g. qwen2.5-vl-7b-instruct>

# ── Development toggles ───────────────────────────────────
# Set to true to expose /docs and /redoc (Swagger/ReDoc). Keep false in production.
API_DOCS=false

# ── JWT (authentication tokens) ──────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_hex_string

# ── First Admin User (created on first startup) ───────────
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change_me_strong_password

# ── Google OAuth2 ─────────────────────────────────────────
# 1. https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Authorized redirect URIs: https://your-domain/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_REDIRECT_URI=https://your-domain/auth/google/callback
FRONTEND_URL=https://your-domain

# ── Traefik / TLS ──────────────────────────────────────────
# Set DOMAIN to your server's IP for now; swap for a real domain to get TLS automatically.
DOMAIN=your-server-ip-or-domain
# Required by Let's Encrypt (notifications about expiring certs)
ACME_EMAIL=you@example.com

