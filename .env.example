# Copy this file to .env and fill in your values.
# Never commit .env to git.

# --- PostgreSQL ---
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ragdb

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=raguser
RABBITMQ_DEFAULT_PASS=change_me_strong_password
# Optional: override the erlang cluster cookie (default is fine for local dev)
#RABBITMQ_ERLANG_COOKIE=change_me_erlang_cookie

# --- S3 object storage ---
# Local dev default: MinIO in docker-compose (http://minio:9000).
# If you need CESNET S3, override these values in your local .env.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_BUCKET_EVIDENCE=rag-evidence-dev
S3_BUCKET_DOCS=rag-documents-dev

# --- MinIO (local dev only) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- LLM (text generation — any OpenAI-compatible endpoint) ---
# Default: e-INFRA AIaaS. Override with any OpenAI-compatible provider.
QUERY_BASE_URL=https://llm.ai.e-infra.cz/v1
QUERY_API_KEY=<your-api-key>
QUERY_MODEL=qwen3.5-122b

# --- VLM (vision extraction — may use a different endpoint/model from LLM) ---
VLM_BASE_URL=https://llm.ai.e-infra.cz/v1
VLM_API_KEY=<your-api-key>
VLM_MODEL=qwen3.5-122b

# --- JWT (auth tokens) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_hex_string

# --- First Admin User (created on first startup) ---
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change_me_strong_password

# --- Keycloak OIDC (optional for local dev, required in production) ---
# To test Keycloak auth locally against the prod Keycloak instance:
#   1. Uncomment and fill in the vars below.
#   2. Run: terraform apply (in infra/terraform/keycloak) — localhost redirect URI
#      is already registered in the rag-system client.
#   3. The "Sign in with SSO" button on the login page will work immediately.
# Production values are injected via Vault/ESO — no .env needed there.
#
# Keycloak admin console: https://keycloak.nss.jkzl.eu/admin/ass-nss-project/console
# Client credentials:     https://keycloak.nss.jkzl.eu/admin/ass-nss-project/console/#/clients
#
# KEYCLOAK_URL=https://keycloak.nss.jkzl.eu
# KEYCLOAK_REALM=ass-nss-project
# KEYCLOAK_CLIENT_ID=rag-system
# KEYCLOAK_CLIENT_SECRET=<copy from Keycloak admin console → Clients → rag-system → Credentials>
# KEYCLOAK_REDIRECT_URI=http://localhost:8080/auth/keycloak/callback
# FRONTEND_URL=http://localhost:8080
# KEYCLOAK_ADMIN_CLIENT_ID=rag-rbac-sa
# KEYCLOAK_ADMIN_CLIENT_SECRET=<copy from Keycloak admin console → Clients → rag-rbac-sa → Credentials>

# --- Development toggles ---
# Set to true to expose /docs and /redoc (Swagger / ReDoc).
API_DOCS=true
