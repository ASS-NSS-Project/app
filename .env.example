# Copy this file to .env and fill in your values.
# Never commit .env to git.

# --- PostgreSQL ---
POSTGRES_USER=raguser
POSTGRES_PASSWORD=raguser
POSTGRES_DB=ragdb

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=raguser
RABBITMQ_DEFAULT_PASS=raguser
# Optional: override the erlang cluster cookie (default is fine for local dev)
#RABBITMQ_ERLANG_COOKIE=change_me_erlang_cookie

# --- S3 object storage ---
# Local dev default: MinIO in docker-compose (http://minio:9000).
# If you need CESNET S3, override these values in your local .env.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_BUCKET_EVIDENCE=rag-evidence-dev
S3_BUCKET_DOCS=rag-documents-dev

# --- MinIO (local dev only) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- LLM (text generation — any OpenAI-compatible endpoint) ---
# Default: e-INFRA AIaaS. Override with any OpenAI-compatible provider.
QUERY_BASE_URL=https://llm.ai.e-infra.cz/v1
QUERY_API_KEY=<your-api-key>
QUERY_MODEL=qwen3.5-122b

# --- VLM (vision extraction — may use a different endpoint/model from LLM) ---
VLM_BASE_URL=https://llm.ai.e-infra.cz/v1
VLM_API_KEY=<your-api-key>
VLM_MODEL=qwen3.5-122b

# --- JWT (auth tokens) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_hex_string

# --- First Admin User (created on first startup) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=test123

# --- Keycloak OIDC (local dev) ---
# Docker Compose starts a local Keycloak at http://localhost:8081 and imports
# keycloak/realm-import.json automatically.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=ass-nss-project
KEYCLOAK_CLIENT_ID=webrag-local
KEYCLOAK_CLIENT_SECRET=webrag-local-secret
KEYCLOAK_REDIRECT_URI=http://localhost:8080/auth/keycloak/callback
FRONTEND_URL=http://localhost:8080

# Local test users, all with password: password
#   webrag-admin@example.local
#   webrag-curator@example.local
#   webrag-analyst@example.local
#   webrag-user@example.local

# --- Qdrant ---
# Replication factor for the vector collection. Set to 3 in production (distributed Qdrant cluster).
# Default is 1 (single-node, local dev).
# QDRANT_REPLICATION_FACTOR=1

# --- Development toggles ---
# Set to true to expose /docs and /redoc (Swagger / ReDoc).
API_DOCS=true
